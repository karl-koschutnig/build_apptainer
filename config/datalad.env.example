# Copy this file to datalad.env (same directory) and keep it private.
#   cp config/datalad.env.example config/datalad.env
#
# This step is entirely optional -- see "Syncing new builds to the datalad
# server" in the README. If you don't use a datalad (or any rsync-over-SSH)
# mirror, skip this file; bin/sync_datalad.sh no-ops safely when it's missing.
#
# Destination for the automatic post-build rsync to the datalad server.
# Requires passwordless (key-based) SSH access from this host to
# DATALAD_USER@DATALAD_HOST already set up.

# Some SSH setups use a domain-style username (e.g. `user@realm`) instead of
# a plain one -- that's the original site-specific reason this looked like
# an email address; don't put the host in here too.
DATALAD_USER=youruser
DATALAD_HOST=your-datalad-host.example.org
DATALAD_PATH=/path/to/datalad/container/

# To sync a different local directory than CONTAINER_DIR (set in
# config/paths.env), override it here:
# CONTAINER_DIR=/path/to/different/directory
