# Copy this file to paths.env (same directory) and edit it for your setup.
#   cp config/paths.env.example config/paths.env
#
# Required by bin/check_and_build.sh, bin/sync_images_all.sh, and
# bin/sync_datalad.sh -- unlike config/ntfy.env / config/datalad.env, this
# file is NOT optional: each script refuses to run without it, since these
# are the paths everything else in the pipeline depends on. There is no
# implicit /data/local default baked into the scripts.

# Where per-app .sif images live, one subfolder per config/apps.conf app
# (e.g. CONTAINER_DIR/qsiprep/qsiprep_1.2.0.sif). Also the tree
# bin/sync_datalad.sh mirrors and bin/sync_images_all.sh reads from.
CONTAINER_DIR=/srv/apptainer_autobuild/container

# Apptainer/Singularity build tmp+cache. Needs room for the largest image
# you're building (several GB per app) -- never point this at a small or
# network filesystem.
TMP_BASE=/srv/apptainer_autobuild/tmp

# Free-space guard: check_and_build.sh aborts before touching Docker Hub
# if this filesystem has less than MIN_FREE_GB free.
DISK_CHECK_PATH=/srv
MIN_FREE_GB=20

# DSI Studio (see "DSI Studio (special case, not in apps.conf)" in the
# README) is hardcoded into check_and_build.sh rather than a
# config/apps.conf row, and needs an external build script this repo
# doesn't ship. If you don't have one, either point this at your own copy
# or remove/stub out process_dsistudio() in bin/check_and_build.sh --
# otherwise every run will log an error and exit non-zero.
DSISTUDIO_BUILD_SCRIPT=/path/to/dsistudio/installation/apptainer/build_image.sh
DSISTUDIO_IMAGES_DIR=/srv/apptainer_autobuild/dsi_studio_images
